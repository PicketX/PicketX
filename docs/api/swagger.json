                "parameters": [
                    {
                        "description": "Exact configured public origin",
                        "in": "header",
                        "name": "Origin",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Bootstrap csrf token (legacy clients)",
                        "in": "header",
                        "name": "X-CSRF-Token",
                        "schema": {
                            "type": "string"
                        }
