    "info": {
        "description": "Database-authoritative desired-state publication for independent API principals. External ingress owns HTTPS; no browser session/login or Agent application claim. Every route is disabled in file mode. Send Authorization: Bearer <independent management Token>.",
        "title": "PicketX management API",
        "version": "1alpha1"
    },
